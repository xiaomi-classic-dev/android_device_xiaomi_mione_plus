# MiOne's legacy sensors HAL reads evdev and controls input-group sysfs nodes.
service vendor.sensors-hal-1-0 /vendor/bin/hw/android.hardware.sensors@1.0-service
    override
    interface android.hardware.sensors@1.0::ISensors default
    class hal
    user system
    group system input wakelock uhid context_hub
    capabilities BLOCK_SUSPEND
    rlimit rtprio 10 10
