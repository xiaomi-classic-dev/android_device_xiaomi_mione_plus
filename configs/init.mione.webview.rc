# A220 cannot import the single-component EGLImages used for WebView YUV planes.
# WebView accepts its command-line file on debuggable Android builds.
on post-fs-data
    copy /vendor/etc/webview-command-line /data/local/tmp/webview-command-line
    chown root root /data/local/tmp/webview-command-line
    chmod 0644 /data/local/tmp/webview-command-line

    mkdir /data/local/debug 0755 root root
    mkdir /data/local/debug/gles 0755 root root
    copy /vendor/lib/libEGL_mione_compat.so /data/local/debug/gles/libEGL_mione_compat.so
    chown root root /data/local/debug/gles/libEGL_mione_compat.so
    chmod 0644 /data/local/debug/gles/libEGL_mione_compat.so
    # Redraw complete frames when legacy buffer dequeue recovery is enabled.
    setprop debug.hwui.use_partial_updates false
    setprop debug.gles.layers libEGL_mione_compat.so
