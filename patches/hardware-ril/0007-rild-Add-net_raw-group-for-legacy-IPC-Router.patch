From 463d08fa27815adba9fdc3802ede55c3233b55a0 Mon Sep 17 00:00:00 2001
From: GuaiYiHu <guaiyihu@foxmail.com>
Date: Fri, 4 Sep 2026 01:07:46 +0800
Subject: [PATCH] rild: Add net_raw group for legacy IPC Router

Change-Id: I28fe49bd33a5fbdc7407bb51ab83b0765c3f2bdb
(cherry picked from commit 06dadc9bcf42068a1e2a72b073dc95ed3e4920e9)
---
 rild/rild.rc | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/rild/rild.rc b/rild/rild.rc
index f6beb54..15963e1 100644
--- a/rild/rild.rc
+++ b/rild/rild.rc
@@ -1,5 +1,8 @@
 service vendor.ril-daemon /vendor/bin/hw/rild
     class main
     user radio
-    group radio cache inet misc audio log readproc wakelock
+    # msm8994's legacy IPC Router checks AID_NET_RAW in the supplementary
+    # group list when rild sends QMI messages; Linux capabilities alone are
+    # not sufficient for that kernel-side security rule.
+    group radio cache inet misc audio log readproc wakelock net_raw
     capabilities BLOCK_SUSPEND NET_ADMIN NET_RAW
