From 3e920633f72fec2a163535ef9fca226b49914a9c Mon Sep 17 00:00:00 2001
From: GuaiYiHu <guaiyihu@foxmail.com>
Date: Fri, 4 Sep 2026 01:07:46 +0800
Subject: [PATCH] keystore2: Add groups for legacy QSEE keymaster

Change-Id: I4103c210fd8da8a73f02a113742fa35e230280e2
(cherry picked from commit f02c1f6055610709b0341d5415fba5bcba638d56)
---
 keystore2/keystore2.rc | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/keystore2/keystore2.rc b/keystore2/keystore2.rc
index 82bf3b8..8c3d7af 100644
--- a/keystore2/keystore2.rc
+++ b/keystore2/keystore2.rc
@@ -2,12 +2,15 @@
 # Keystore 2.0 changes its working directory to the first positional
 # command line option, i.e., /data/misc/keystore, where it stores its
 # database.
-# Keystore shall run as user keystore and groups keystore, readproc, and log.
+# Keystore shall run as user keystore and groups keystore, readproc, log,
+# system, and drmrpc. The legacy passthrough Keymaster HAL needs the system
+# group to read the TrustZone applications from the firmware partition and the
+# drmrpc group to access /dev/qseecom.
 #
 # See system/core/init/README.md for information on the init.rc language.
 
 service keystore2 /system/bin/keystore2 /data/misc/keystore
     class early_hal
     user keystore
-    group keystore readproc log
+    group keystore readproc log system drmrpc
     writepid /dev/cpuset/foreground/tasks
