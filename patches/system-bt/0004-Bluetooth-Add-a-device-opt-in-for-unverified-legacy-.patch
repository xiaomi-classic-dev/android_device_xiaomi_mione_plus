From 6b3580e84da1554302a524a0fdf330b9841247ee Mon Sep 17 00:00:00 2001
From: GuaiYiHu <guaiyihu@foxmail.com>
Date: Sat, 3 Oct 2026 07:55:03 +0800
Subject: [PATCH 4/4] Bluetooth: Add a device opt-in for unverified legacy
 BR/EDR key sizes

Keep the default minimum key-size checks. A device policy may accept only
an exact one-byte Unknown HCI Command response after a successful
Encryption Change or Key Refresh event. Preserve the originating handle
and event type and explicitly log that the key size remains unverified.

Do not fabricate a key size or accept short keys, malformed successful
responses, mismatched handles, or other command errors. Builds without
the device policy retain the existing fail-closed behavior.

Test: Current callback functions tested with ASan/UBSan, 3,760,128
response scenarios per policy, including absent version and mismatched
controller versions; 1,536 encryption-event gate scenarios per policy.
Test: mka bluetooth.default, cm_mione_plus-userdebug, JDK 8 / Python 2.7.

Change-Id: I51b9e228453a7ed8337d1b832eb023649615bd51
---
 stack/btu/btu_hcif.c | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/stack/btu/btu_hcif.c b/stack/btu/btu_hcif.c
index ef68b7294aca3d67a78e5202fb787af43ee9e432..50fd2af108b5c8bddc9bf29a8103105a90a168bf 100644
--- a/stack/btu/btu_hcif.c
+++ b/stack/btu/btu_hcif.c
@@ -701,6 +701,21 @@ static void read_encryption_key_size_complete(UINT8 *p, UINT16 evt_len,
     }
   }
 
+#ifdef BTM_ALLOW_UNVERIFIED_BR_EDR_KEY_SIZE
+  // Device opt-in for a controller that cannot report the key size. Preserve
+  // the real successful Encryption Change/Key Refresh event; do not invent
+  // a key size or turn any other command failure into success.
+  const bt_version_t *version = controller_get_interface()->get_bt_version();
+  if (evt_len == 1 && BTM_ALLOW_UNVERIFIED_BR_EDR_KEY_SIZE(status, version)) {
+    HCI_TRACE_WARNING("%s device legacy policy accepts an encrypted link "
+        "with UNVERIFIED key size, handle: 0x%02x", __func__, handle);
+    if (!from_key_refresh)
+      btm_acl_encrypt_change(handle, HCI_SUCCESS, 1);
+    btm_sec_encrypt_change(handle, HCI_SUCCESS, 1);
+    return;
+  }
+#endif
+
   if (from_key_refresh) {
     read_encryption_key_size_complete_after_key_refresh(status, handle, key_size);
   } else {
