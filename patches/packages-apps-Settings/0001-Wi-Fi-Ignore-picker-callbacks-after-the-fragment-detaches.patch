From 1a97cd729dcf0d504a194e2723745ae9e6e86aca Mon Sep 17 00:00:00 2001
From: GuaiYiHu <guaiyihu@foxmail.com>
Date: Sun, 11 Oct 2026 19:04:47 +0800
Subject: [PATCH] Wi-Fi: Ignore picker callbacks after the fragment detaches

Retain the MiOne 18.1 lifecycle guard in the renamed Android 12 WifiSettings fragment. WifiPickerTracker callbacks can arrive after the Activity is gone, before the setup Next-button update.

Adapted from commit a7928d92051f66ec29bbecfb4754c4618a07d4ab.

Change-Id: I4e824c2fb6babe2117720b0084cabcb6e4206a8d
---
 src/com/android/settings/wifi/WifiSettings.java | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/com/android/settings/wifi/WifiSettings.java b/src/com/android/settings/wifi/WifiSettings.java
index 4c7be5871d..2256e44d41 100644
--- a/src/com/android/settings/wifi/WifiSettings.java
+++ b/src/com/android/settings/wifi/WifiSettings.java
@@ -689,6 +689,9 @@ public class WifiSettings extends RestrictedSettingsFragment
 
     @Override
     public void onWifiEntriesChanged() {
+        if (getActivity() == null) {
+            return;
+        }
         if (mIsWifiEntryListStale) {
             mIsWifiEntryListStale = false;
             updateWifiEntryPreferences();
