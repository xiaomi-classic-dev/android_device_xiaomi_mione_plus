From 50fae39711fb16ee54f9ac7f359f2655f07027e6 Mon Sep 17 00:00:00 2001
From: GuaiYiHu <guaiyihu@foxmail.com>
Date: Sun, 11 Oct 2026 20:20:05 +0800
Subject: [PATCH] binder: Widen legacy protocol integers before debug pointer
 casts

MiOne uses the 32-bit Binder protocol. The product setting also reaches 64-bit host libbinder variants, where direct casts from binder_size_t and binder_uintptr_t to pointers fail the integer-to-pointer size warning promoted to an error.

Convert through uintptr_t in the three debug-only formatting paths. Preserve the selected Binder wire protocol and device runtime behavior without disabling compiler diagnostics.

Change-Id: I18b96a1cab3fb7fa8e4a862cd0e77917d8665935
---
 libs/binder/IPCThreadState.cpp | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/libs/binder/IPCThreadState.cpp b/libs/binder/IPCThreadState.cpp
index 0d653caf5d..3d03bc811a 100644
--- a/libs/binder/IPCThreadState.cpp
+++ b/libs/binder/IPCThreadState.cpp
@@ -137,9 +137,9 @@ static const void* printBinderTransactionData(TextOutput& out, const void* data)
     }
     out << " (cookie " << btd->cookie << ")" << endl
         << "code=" << TypeCode(btd->code) << ", flags=" << (void*)(uint64_t)btd->flags << endl
-        << "data=" << btd->data.ptr.buffer << " (" << (void*)btd->data_size
+        << "data=" << btd->data.ptr.buffer << " (" << reinterpret_cast<void*>(static_cast<uintptr_t>(btd->data_size))
         << " bytes)" << endl
-        << "offsets=" << btd->data.ptr.offsets << " (" << (void*)btd->offsets_size
+        << "offsets=" << btd->data.ptr.offsets << " (" << reinterpret_cast<void*>(static_cast<uintptr_t>(btd->offsets_size))
         << " bytes)";
     return btd+1;
 }
@@ -1004,7 +1004,7 @@ status_t IPCThreadState::talkWithDriver(bool doReceive)
         TextOutput::Bundle _b(alog);
         if (outAvail != 0) {
             alog << "Sending commands to driver: " << indent;
-            const void* cmds = (const void*)bwr.write_buffer;
+            const void* cmds = reinterpret_cast<const void*>(static_cast<uintptr_t>(bwr.write_buffer));
             const void* end = ((const uint8_t*)cmds)+bwr.write_size;
             alog << HexDump(cmds, bwr.write_size) << endl;
             while (cmds < end) cmds = printCommand(alog, cmds);
