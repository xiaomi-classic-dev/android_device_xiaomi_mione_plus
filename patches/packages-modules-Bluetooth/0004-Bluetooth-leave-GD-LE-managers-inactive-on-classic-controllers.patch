From eefbe788cd497dc8dd49e31047cd18e4edc2ea8c Mon Sep 17 00:00:00 2001
From: GuaiYiHu <guaiyihu@foxmail.com>
Date: Tue, 13 Oct 2026 01:36:27 +0800
Subject: [PATCH] Bluetooth: leave GD LE managers inactive on classic
 controllers

Keep zero advertising instances and avoid obtaining LE advertising/scanning interfaces or sending LE startup commands when the controller reports no LE support. Preserve valid basic pointers and empty manager state for teardown. Complete scanner registration/parameter requests with failure callbacks and avoid indexing an empty scanner list or submitting scan commands. Skip local LE privacy configuration, which otherwise rotates a random address through LE_SET_RANDOM_ADDRESS. LE-capable controllers retain their existing manager path.

Change-Id: Ia9c183e6b401401b4c75ccb2b876ff04b5177050
---
 system/bta/dm/bta_dm_act.cc             |  1 +
 system/gd/hci/le_advertising_manager.cc |  8 ++++++--
 system/gd/hci/le_scanning_manager.cc    | 15 +++++++++++++++
 3 files changed, 22 insertions(+), 2 deletions(-)

diff --git a/system/bta/dm/bta_dm_act.cc b/system/bta/dm/bta_dm_act.cc
index b9b684449d..c1bc3ae556 100644
--- a/system/bta/dm/bta_dm_act.cc
+++ b/system/bta/dm/bta_dm_act.cc
@@ -3859,6 +3859,7 @@ void bta_dm_ble_update_conn_params(const RawAddress& bd_addr, uint16_t min_int,
 
 /** This function set the local device LE privacy settings. */
 void bta_dm_ble_config_local_privacy(bool privacy_enable) {
+  if (!controller_get_interface()->supports_ble()) return;
   BTM_BleConfigPrivacy(privacy_enable);
 }
 
diff --git a/system/gd/hci/le_advertising_manager.cc b/system/gd/hci/le_advertising_manager.cc
index c96b97197c..4b5bce0005 100644
--- a/system/gd/hci/le_advertising_manager.cc
+++ b/system/gd/hci/le_advertising_manager.cc
@@ -117,6 +117,10 @@ struct LeAdvertisingManager::impl : public bluetooth::hci::LeAddressManagerCallb
     acl_manager_ = acl_manager;
     le_address_manager_ = acl_manager->GetLeAddressManager();
     num_instances_ = controller_->GetLeNumberOfSupportedAdverisingSets();
+    if (!controller_->SupportsBle()) {
+      LOG_INFO("Controller has no LE advertising capability");
+      return;
+    }
 
     le_advertising_interface_ =
         hci_layer_->GetLeAdvertisingInterface(module_handler_->BindOn(this, &LeAdvertisingManager::impl::handle_event));
@@ -1195,7 +1199,7 @@ struct LeAdvertisingManager::impl : public bluetooth::hci::LeAddressManagerCallb
   hci::Controller* controller_;
   uint16_t le_maximum_advertising_data_length_;
   int8_t le_physical_channel_tx_power_ = 0;
-  hci::LeAdvertisingInterface* le_advertising_interface_;
+  hci::LeAdvertisingInterface* le_advertising_interface_ = nullptr;
   std::map<AdvertiserId, Advertiser> advertising_sets_;
   hci::LeAddressManager* le_address_manager_;
   hci::AclManager* acl_manager_;
@@ -1203,7 +1207,7 @@ struct LeAdvertisingManager::impl : public bluetooth::hci::LeAddressManagerCallb
   bool paused = false;
 
   std::mutex id_mutex_;
-  size_t num_instances_;
+  size_t num_instances_ = 0;
   std::vector<hci::EnabledSet> enabled_sets_;
   // map to mapping the id from java layer and advertier id
   std::map<uint8_t, int> id_map_;
diff --git a/system/gd/hci/le_scanning_manager.cc b/system/gd/hci/le_scanning_manager.cc
index d48c900a51..32efa74539 100644
--- a/system/gd/hci/le_scanning_manager.cc
+++ b/system/gd/hci/le_scanning_manager.cc
@@ -249,6 +249,10 @@ struct LeScanningManager::impl : public LeAddressManagerCallback {
     vendor_specific_event_manager_ = vendor_specific_event_manager;
     storage_module_ = storage_module;
     le_address_manager_ = acl_manager->GetLeAddressManager();
+    if (!controller_->SupportsBle()) {
+      LOG_INFO("Controller has no LE scanning capability");
+      return;
+    }
     le_scanning_interface_ = hci_layer_->GetLeScanningInterface(
         module_handler_->BindOn(this, &LeScanningManager::impl::handle_scan_results));
     periodic_sync_manager_.Init(le_scanning_interface_, module_handler_);
@@ -292,6 +296,7 @@ struct LeScanningManager::impl : public LeAddressManagerCallback {
   }
 
   void stop() {
+    if (le_scanning_interface_ == nullptr) return;
     for (auto subevent_code : LeScanningEvents) {
       hci_layer_->UnregisterLeEventHandler(subevent_code);
     }
@@ -582,6 +587,10 @@ struct LeScanningManager::impl : public LeAddressManagerCallback {
   }
 
   void register_scanner(const Uuid app_uuid) {
+    if (le_scanning_interface_ == nullptr) {
+      scanning_callbacks_->OnScannerRegistered(app_uuid, 0x00, ScanningCallback::ScanningStatus::INTERNAL_ERROR);
+      return;
+    }
     for (uint8_t i = 1; i <= kMaxAppNum; i++) {
       if (scanners_[i].in_use && scanners_[i].app_uuid == app_uuid) {
         LOG_ERROR("Application already registered %s", app_uuid.ToString().c_str());
@@ -605,6 +614,7 @@ struct LeScanningManager::impl : public LeAddressManagerCallback {
   }
 
   void unregister_scanner(ScannerId scanner_id) {
+    if (le_scanning_interface_ == nullptr) return;
     if (scanner_id <= 0 || scanner_id > kMaxAppNum) {
       LOG_WARN("Invalid scanner id");
       return;
@@ -619,6 +629,7 @@ struct LeScanningManager::impl : public LeAddressManagerCallback {
   }
 
   void scan(bool start) {
+    if (le_scanning_interface_ == nullptr) return;
     if (start) {
       configure_scan();
       start_scan();
@@ -684,6 +695,10 @@ struct LeScanningManager::impl : public LeAddressManagerCallback {
   }
 
   void set_scan_parameters(ScannerId scanner_id, LeScanType scan_type, uint16_t scan_interval, uint16_t scan_window) {
+    if (le_scanning_interface_ == nullptr) {
+      scanning_callbacks_->OnSetScannerParameterComplete(scanner_id, ScanningCallback::ScanningStatus::ILLEGAL_PARAMETER);
+      return;
+    }
     uint32_t max_scan_interval = kLeScanIntervalMax;
     uint32_t max_scan_window = kLeScanWindowMax;
     if (api_type_ == ScanApiType::EXTENDED) {
