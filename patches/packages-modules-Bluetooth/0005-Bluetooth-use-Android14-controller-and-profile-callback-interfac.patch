From b823053b6af7d0fe66d94d8b8bd1e912c9b1827d Mon Sep 17 00:00:00 2001
From: GuaiYiHu <guaiyihu@foxmail.com>
Date: Thu, 15 Oct 2026 00:38:12 +0800
Subject: [PATCH] Bluetooth: use Android14 controller and profile callback
 interfaces

Change-Id: Ia9113258a2f9f9eea0beb795d55c1816cd927586
---
 system/bta/dm/bta_dm_act.cc  | 2 +-
 system/bta/dm/bta_dm_sec.cc  | 3 ++-
 system/btif/src/btif_core.cc | 4 ++--
 system/stack/btm/btm_sec.cc  | 2 +-
 4 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/system/bta/dm/bta_dm_act.cc b/system/bta/dm/bta_dm_act.cc
index 23637035d7..8ec1a26811 100644
--- a/system/bta/dm/bta_dm_act.cc
+++ b/system/bta/dm/bta_dm_act.cc
@@ -268,7 +268,7 @@ void BTA_dm_on_hw_on() {
       osi_property_get_int32(PROPERTY_PAGE_TIMEOUT,
                              p_bta_dm_cfg->page_timeout));
 
-  if (controller_get_interface()->supports_ble()) {
+  if (controller_get_interface()->SupportsBle()) {
     if (ble_vnd_is_included()) {
       get_btm_client_interface().ble.BTM_BleReadControllerFeatures(
           bta_dm_ctrl_features_rd_cmpl_cback);
diff --git a/system/bta/dm/bta_dm_sec.cc b/system/bta/dm/bta_dm_sec.cc
index 37dbfa9105..0ae859a4eb 100644
--- a/system/bta/dm/bta_dm_sec.cc
+++ b/system/bta/dm/bta_dm_sec.cc
@@ -16,6 +16,7 @@
 
 #define LOG_TAG "bt_bta_dm_sec"
 
+#include "device/include/controller.h"
 #include <bluetooth/log.h>
 
 #include <cstdint>
@@ -1069,7 +1070,7 @@ void bta_dm_ble_confirm_reply(const RawAddress& bd_addr, bool accept) {
 
 /** This function set the local device LE privacy settings. */
 void bta_dm_ble_config_local_privacy(bool privacy_enable) {
-  if (!controller_get_interface()->supports_ble()) return;
+  if (!controller_get_interface()->SupportsBle()) return;
   BTM_BleConfigPrivacy(privacy_enable);
 }
 
diff --git a/system/btif/src/btif_core.cc b/system/btif/src/btif_core.cc
index a54274838c..da92fa3db7 100644
--- a/system/btif/src/btif_core.cc
+++ b/system/btif/src/btif_core.cc
@@ -456,10 +456,10 @@ void btif_get_adapter_property(bt_property_type_t type) {
     tBTM_BLE_VSC_CB cmn_vsc_cb;
     bt_local_le_features_t local_le_features = {};
 
-    if (!controller_get_interface()->supports_ble()) {
+    if (!controller_get_interface()->SupportsBle()) {
       prop.len = sizeof(local_le_features);
       memcpy(prop.val, &local_le_features, prop.len);
-      invoke_adapter_properties_cb(status, 1, &prop);
+      GetInterfaceToProfiles()->events->invoke_adapter_properties_cb(status, 1, &prop);
       return;
     }
 
diff --git a/system/stack/btm/btm_sec.cc b/system/stack/btm/btm_sec.cc
index 47563b2b33..57630c62d7 100644
--- a/system/stack/btm/btm_sec.cc
+++ b/system/stack/btm/btm_sec.cc
@@ -396,7 +396,7 @@ bool BTM_SecRegister(const tBTM_APPL_INFO* p_cb_info) {
     SMP_Register(btm_proc_smp_cback);
     Octet16 zero{0};
     /* if no IR is loaded, need to regenerate all the keys */
-    if (controller_get_interface()->supports_ble() &&
+    if (controller_get_interface()->SupportsBle() &&
         btm_sec_cb.devcb.id_keys.ir == zero) {
       btm_ble_reset_id();
     }
