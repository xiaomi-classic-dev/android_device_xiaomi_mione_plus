From eca30ea0736094989ca6499889dbd60503779ab6 Mon Sep 17 00:00:00 2001
From: GuaiYiHu <guaiyihu@foxmail.com>
Date: Sun, 11 Oct 2026 18:59:35 +0800
Subject: [PATCH] Bluetooth: guard LE initialization and capability reporting
 for classic controllers

Adapt the legacy controller capability guard to Android 13: advertising and scanner initialization run only on LE controllers. Complete the existing LE-features callback with fully zeroed capabilities for classic controllers, avoiding any unsupported feature query. Keep BR/EDR startup completion and supported-LE behavior unchanged.

(cherry picked from commit 046a0e146cfc1121879d8427ad239d77f456eeec)
Change-Id: I5923ac2fe00d97bd052b607d3d0f83e05f6e9160
---
 system/bta/dm/bta_dm_act.cc  | 4 ++++
 system/btif/src/btif_core.cc | 9 ++++++++-
 2 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/system/bta/dm/bta_dm_act.cc b/system/bta/dm/bta_dm_act.cc
index 0ad1e185c3..b9b684449d 100644
--- a/system/bta/dm/bta_dm_act.cc
+++ b/system/bta/dm/bta_dm_act.cc
@@ -399,6 +399,7 @@ void BTA_dm_on_hw_on() {
 
   BTM_WritePageTimeout(p_bta_dm_cfg->page_timeout);
 
+  if (controller_get_interface()->supports_ble()) {
 #if (BLE_VND_INCLUDED == TRUE)
   BTM_BleReadControllerFeatures(bta_dm_ctrl_features_rd_cmpl_cback);
 #else
@@ -412,6 +413,9 @@ void BTA_dm_on_hw_on() {
 #endif
 
   btm_ble_scanner_init();
+  } else if (bta_dm_cb.p_sec_cback) {
+    bta_dm_cb.p_sec_cback(BTA_DM_LE_FEATURES_READ, NULL);
+  }
 
   /* Earlier, we used to invoke BTM_ReadLocalAddr which was just copying the
      bd_addr
diff --git a/system/btif/src/btif_core.cc b/system/btif/src/btif_core.cc
index c289758531..6287a55d37 100644
--- a/system/btif/src/btif_core.cc
+++ b/system/btif/src/btif_core.cc
@@ -573,7 +573,14 @@ void btif_get_adapter_property(bt_property_type_t type) {
   prop.len = sizeof(buf);
   if (prop.type == BT_PROPERTY_LOCAL_LE_FEATURES) {
     tBTM_BLE_VSC_CB cmn_vsc_cb;
-    bt_local_le_features_t local_le_features;
+    bt_local_le_features_t local_le_features = {};
+
+    if (!controller_get_interface()->supports_ble()) {
+      prop.len = sizeof(local_le_features);
+      memcpy(prop.val, &local_le_features, prop.len);
+      invoke_adapter_properties_cb(status, 1, &prop);
+      return;
+    }
 
     /* LE features are not stored in storage. Should be retrived from stack
      */
