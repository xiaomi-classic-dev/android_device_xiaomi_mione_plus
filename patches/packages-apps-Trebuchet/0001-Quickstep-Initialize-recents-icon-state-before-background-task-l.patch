From b7101f50cf6009d6bc1e995bb3238572e8f212fa Mon Sep 17 00:00:00 2001
From: GuaiYiHu <guaiyihu@foxmail.com>
Date: Fri, 9 Oct 2026 00:38:00 +0800
Subject: [PATCH] Quickstep: Initialize recents icon state before background
 task loading

RecentsModel constructs its task and icon loaders on the main thread before registering task-stack callbacks. Resolve LauncherIcons and its LauncherAppState device profile during that construction, instead of lazily from a Binder preload callback holding the RecentsTaskLoader monitor.

A MiOne Plus Pie first boot exposed a circular wait: Binder held the task-loader monitor and waited on LauncherAppState.getInstance via MainThreadExecutor, while the Launcher main thread entered onStop/onTrimMemory and waited for the same monitor. Constructing the final icon state before exposing the loader removes this main-thread round trip under the background lock without disabling task preload or changing the recents UI.

Change-Id: I91a4110db7461e8c4706620b90afd975adcb207e
---
 .../com/android/quickstep/NormalizedIconLoader.java    | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/quickstep/src/com/android/quickstep/NormalizedIconLoader.java b/quickstep/src/com/android/quickstep/NormalizedIconLoader.java
index f875bb786..53a1c7f6f 100644
--- a/quickstep/src/com/android/quickstep/NormalizedIconLoader.java
+++ b/quickstep/src/com/android/quickstep/NormalizedIconLoader.java
@@ -42,12 +42,16 @@ public class NormalizedIconLoader extends IconLoader {
 
     private final SparseArray<BitmapInfo> mDefaultIcons = new SparseArray<>();
     private final DrawableFactory mDrawableFactory;
-    private LauncherIcons mLauncherIcons;
+    private final LauncherIcons mLauncherIcons;
 
     public NormalizedIconLoader(Context context, TaskKeyLruCache<Drawable> iconCache,
             LruCache<ComponentName, ActivityInfo> activityInfoCache) {
         super(context, iconCache, activityInfoCache);
         mDrawableFactory = DrawableFactory.get(context);
+        // RecentsModel creates this loader on the UI thread. Resolve the launcher
+        // profile here, before background loads can hold the task-loader lock
+        // while waiting for LauncherAppState on the UI thread.
+        mLauncherIcons = LauncherIcons.obtain(context);
     }
 
     @Override
@@ -72,10 +76,6 @@ public class NormalizedIconLoader extends IconLoader {
 
     private synchronized BitmapInfo getBitmapInfo(Drawable drawable, int userId,
             int primaryColor, boolean isInstantApp) {
-        if (mLauncherIcons == null) {
-            mLauncherIcons = LauncherIcons.obtain(mContext);
-        }
-
         mLauncherIcons.setWrapperBackgroundColor(primaryColor);
         // User version code O, so that the icon is always wrapped in an adaptive icon container.
         return mLauncherIcons.createBadgedIconBitmap(drawable, UserHandle.of(userId),
