From 042355cdf4e20631e7e3ebc8d3704492f05d8915 Mon Sep 17 00:00:00 2001
From: Matt Mower <mowerm@gmail.com>
Date: Wed, 7 Oct 2026 21:05:39 +0800
Subject: [PATCH] linker: Preserve device-selected non-PIE execution on Android
 11

Adapt the fixed-address exact-path compatibility to ExecutableInfo and the Android 11 Soong defaults. Devices without an allowlist retain normal PIE-only behavior. Compile the optional helper in liblinker_main rather than the final binary so all linker variants resolve the allowlist symbol.

Adapted-from: d75a7f53bf38a32de8bf8d08a17574ef9b78c8e7

Original-upstream: LineageOS/android_bionic 55db1141913a77289abd293bca807e0520fd600a
Change-Id: I19c7bd5964271bcf2a578079200b59f453068619
---
 linker/Android.bp         |  3 ++-
 linker/linker_main.cpp    |  9 ++++++++-
 linker/linker_non_pie.cpp | 38 ++++++++++++++++++++++++++++++++++++++
 linker/linker_non_pie.h   | 22 ++++++++++++++++++++++
 4 files changed, 70 insertions(+), 2 deletions(-)
 create mode 100644 linker/linker_non_pie.cpp
 create mode 100644 linker/linker_non_pie.h

diff --git a/linker/Android.bp b/linker/Android.bp
index 582a9e41e..06c0a52b8 100644
--- a/linker/Android.bp
+++ b/linker/Android.bp
@@ -59,6 +59,7 @@ cc_defaults {
     name: "linker_defaults",
     defaults: [
         "process_sdk_version_overrides_defaults",
+        "non_pie_executables_defaults",
         "shim_libs_defaults",
     ],
     arch: {
@@ -129,7 +130,7 @@ cc_defaults {
 cc_library_static {
     name: "liblinker_main",
     defaults: ["linker_defaults", "linker_all_targets"],
-    srcs: ["linker_main.cpp"],
+    srcs: ["linker_main.cpp", "linker_non_pie.cpp"],
 
     // Ensure that the compiler won't insert string function calls before ifuncs are resolved.
     cflags: ["-ffreestanding"],
diff --git a/linker/linker_main.cpp b/linker/linker_main.cpp
index 22c034b61..d95f372ae 100644
--- a/linker/linker_main.cpp
+++ b/linker/linker_main.cpp
@@ -27,6 +27,9 @@
  */
 
 #include "linker_main.h"
+#ifdef ENABLE_NON_PIE_SUPPORT
+#include "linker_non_pie.h"
+#endif
 
 #include <link.h>
 #include <sys/auxv.h>
@@ -398,7 +401,11 @@ static ElfW(Addr) linker_main(KernelArgumentBlock& args, const char* exe_to_load
   ElfW(Ehdr)* elf_hdr = reinterpret_cast<ElfW(Ehdr)*>(si->base);
 
   // We haven't supported non-PIE since Lollipop for security reasons.
-  if (elf_hdr->e_type != ET_DYN) {
+  if (elf_hdr->e_type != ET_DYN
+#ifdef ENABLE_NON_PIE_SUPPORT
+      && !(elf_hdr->e_type == ET_EXEC && allow_non_pie(exe_info.path.c_str()))
+#endif
+      ) {
     // We don't use async_safe_fatal here because we don't want a tombstone:
     // even after several years we still find ourselves on app compatibility
     // investigations because some app's trying to launch an executable that
diff --git a/linker/linker_non_pie.cpp b/linker/linker_non_pie.cpp
new file mode 100644
index 000000000..1eb6e236e
--- /dev/null
+++ b/linker/linker_non_pie.cpp
@@ -0,0 +1,38 @@
+#ifdef ENABLE_NON_PIE_SUPPORT
+/*
+ * Copyright (C) 2017 The LineageOS Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+/*
+ * linker_non_pie_executables.h syntax:
+ *
+ * const char* linker_non_pie_executables[] = {
+ *     "/path/to/executable1",
+ *     "/path/to/executable2",
+ * };
+ */
+
+#include <string.h>
+#include "linker_non_pie_executables.h"
+
+bool allow_non_pie(const char* executable) {
+    const int array_len = sizeof(linker_non_pie_executables)/sizeof(*linker_non_pie_executables);
+    for (int i = 0; i < array_len; i++) {
+        if (!strcmp(linker_non_pie_executables[i], executable))
+            return true;
+    }
+    return false;
+}
+#endif
diff --git a/linker/linker_non_pie.h b/linker/linker_non_pie.h
new file mode 100644
index 000000000..f6f66c653
--- /dev/null
+++ b/linker/linker_non_pie.h
@@ -0,0 +1,22 @@
+/*
+ * Copyright (C) 2017 The LineageOS Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#ifndef _LINKER_NON_PIE_H_
+#define _LINKER_NON_PIE_H_
+
+bool allow_non_pie(const char* executable);
+
+#endif // _LINKER_NON_PIE_H_
