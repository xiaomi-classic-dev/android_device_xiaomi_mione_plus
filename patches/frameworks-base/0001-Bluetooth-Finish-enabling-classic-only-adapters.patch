From cc2632fd53481aa398365dacfb21428784a8dc6c Mon Sep 17 00:00:00 2001
From: GuaiYiHu <guaiyihu@foxmail.com>
Date: Sat, 3 Oct 2026 03:06:02 +0800
Subject: [PATCH] Bluetooth: Finish enabling classic-only adapters

STATE_BLE_ON is also the intermediate native startup state on adapters built without BLE. Such devices cannot bind GattService, leaving Bluetooth enable stuck until it times out. Advance BR/EDR startup directly when FEATURE_BLUETOOTH_LE is absent, using the same helper invoked after GATT connects. Preserve the existing BLE service path and do not advertise unsupported BLE hardware.

Change-Id: If23dd7ecd9d1611678dc75f828154edcd56971e1
(cherry picked from commit 70135133806e64ecc9cc392de1f5ec802c4cbdca)
---
 .../core/java/com/android/server/BluetoothManagerService.java  | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/services/core/java/com/android/server/BluetoothManagerService.java b/services/core/java/com/android/server/BluetoothManagerService.java
index acfa5b502f67e6e9460397b74c1f3956ccf22d5d..8f062fcaedd1c910e7adb3f42ca7b583faa6e0b9 100644
--- a/services/core/java/com/android/server/BluetoothManagerService.java
+++ b/services/core/java/com/android/server/BluetoothManagerService.java
@@ -1944,6 +1944,9 @@ class BluetoothManagerService extends IBluetoothManager.Stub {
                                                     PackageManager.FEATURE_BLUETOOTH_LE)) {
                         Intent i = new Intent(IBluetoothGatt.class.getName());
                         doBind(i, mConnection, Context.BIND_AUTO_CREATE | Context.BIND_IMPORTANT, UserHandle.CURRENT);
+                    } else {
+                        // Classic-only adapters have no GATT service to advance startup.
+                        onBluetoothGattServiceUp();
                     }
                 }
                 sendBleStateChanged(prevState, newState);
