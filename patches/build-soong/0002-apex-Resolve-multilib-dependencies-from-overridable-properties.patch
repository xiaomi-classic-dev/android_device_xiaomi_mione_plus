From 5c42b7f54f50ed7d6c3ce4a31f6edb57932e349c Mon Sep 17 00:00:00 2001
From: GuaiYiHu <guaiyihu@foxmail.com>
Date: Fri, 16 Oct 2026 16:30:14 +0800
Subject: [PATCH] apex: Resolve multilib dependencies from overridable
 properties

Use one multilib property set for base and override APEXes. The duplicate base property set caused override multilib dependencies to be ignored during dependency selection. Check actual copied binaries and ABI-specific libraries in the override test.

Change-Id: Ie8f1eda133d9f2f1efb795c9da4db89c3464b8f3
---
 apex/apex.go      | 16 +++++++---------
 apex/apex_test.go | 11 +++++++++++
 2 files changed, 18 insertions(+), 9 deletions(-)

diff --git a/apex/apex.go b/apex/apex.go
index 7cc583682..0e7acbc62 100644
--- a/apex/apex.go
+++ b/apex/apex.go
@@ -98,8 +98,6 @@ type apexBundleProperties struct {
 
 	ApexNativeDependencies
 
-	Multilib apexMultilibProperties
-
 	// List of runtime resource overlays (RROs) that are embedded inside this APEX.
 	Rros []string
 
@@ -771,7 +769,7 @@ func addDependenciesForNativeModules(ctx android.BottomUpMutatorContext, nativeM
 }
 
 func (a *apexBundle) combineProperties(ctx android.BottomUpMutatorContext) {
-	proptools.AppendProperties(&a.properties.Multilib, &a.targetProperties.Target.Android.Multilib, nil)
+	proptools.AppendProperties(&a.overridableProperties.Multilib, &a.targetProperties.Target.Android.Multilib, nil)
 }
 
 // getImageVariationPair returns a pair for the image variation name as its
@@ -822,7 +820,7 @@ func (a *apexBundle) DepsMutator(ctx android.BottomUpMutatorContext) {
 
 		// Add native modules targeting both ABIs. When multilib.* is omitted for
 		// native_shared_libs/jni_libs/tests, it implies multilib.both
-		deps.Merge(ctx, a.properties.Multilib.Both)
+		deps.Merge(ctx, a.overridableProperties.Multilib.Both)
 		deps.Merge(ctx, ApexNativeDependencies{
 			Native_shared_libs: a.properties.Native_shared_libs,
 			Rust_dyn_libs:      a.properties.Rust_dyn_libs,
@@ -834,7 +832,7 @@ func (a *apexBundle) DepsMutator(ctx android.BottomUpMutatorContext) {
 		// binaries, it implies multilib.first
 		isPrimaryAbi := i == 0
 		if isPrimaryAbi {
-			deps.Merge(ctx, a.properties.Multilib.First)
+			deps.Merge(ctx, a.overridableProperties.Multilib.First)
 			deps.Merge(ctx, ApexNativeDependencies{
 				Native_shared_libs: proptools.NewConfigurable[[]string](nil, nil),
 				Tests:              nil,
@@ -846,12 +844,12 @@ func (a *apexBundle) DepsMutator(ctx android.BottomUpMutatorContext) {
 		// Add native modules targeting either 32-bit or 64-bit ABI
 		switch target.Arch.ArchType.Multilib {
 		case "lib32":
-			deps.Merge(ctx, a.properties.Multilib.Lib32)
-			deps.Merge(ctx, a.properties.Multilib.Prefer32)
+			deps.Merge(ctx, a.overridableProperties.Multilib.Lib32)
+			deps.Merge(ctx, a.overridableProperties.Multilib.Prefer32)
 		case "lib64":
-			deps.Merge(ctx, a.properties.Multilib.Lib64)
+			deps.Merge(ctx, a.overridableProperties.Multilib.Lib64)
 			if !has32BitTarget {
-				deps.Merge(ctx, a.properties.Multilib.Prefer32)
+				deps.Merge(ctx, a.overridableProperties.Multilib.Prefer32)
 			}
 		}
 
diff --git a/apex/apex_test.go b/apex/apex_test.go
index dd55152bf..f35c03cf8 100644
--- a/apex/apex_test.go
+++ b/apex/apex_test.go
@@ -7133,6 +7133,7 @@ func TestOverrideApex(t *testing.T) {
 			name: "myapex",
 			key: "myapex.key",
 			apps: ["app"],
+			multilib: { both: { binaries: ["basebin"], }, },
 			bpfs: ["bpf"],
 			prebuilts: ["myetc"],
 			overrides: ["oldapex"],
@@ -7148,6 +7149,7 @@ func TestOverrideApex(t *testing.T) {
 			overrides: ["unknownapex"],
 			compile_multilib: "first",
 			multilib: {
+				both: { binaries: ["overridebin"], },
 				lib32: {
 					native_shared_libs: ["mylib32"],
 				},
@@ -7213,6 +7215,9 @@ func TestOverrideApex(t *testing.T) {
 			src: "override_myprebuilt",
 		}
 
+		cc_binary { name: "basebin", apex_available: ["myapex"], }
+		cc_binary { name: "overridebin", apex_available: ["myapex"], }
+
 		cc_library {
 			name: "mylib32",
 			apex_available: [ "myapex" ],
@@ -7236,6 +7241,12 @@ func TestOverrideApex(t *testing.T) {
 	module := ctx.ModuleForTests("myapex", "android_common_override_myapex_override_myapex")
 	apexRule := module.Rule("apexRule")
 	copyCmds := apexRule.Args["copy_commands"]
+	ensureContains(t, copyCmds, "image.apex/bin/overridebin")
+	ensureNotContains(t, copyCmds, "image.apex/bin/basebin")
+	ensureContains(t, copyCmds, "image.apex/lib64/mylib64.so")
+	baseCopy := ctx.ModuleForTests("myapex", "android_common_myapex").Rule("apexRule").Args["copy_commands"]
+	ensureContains(t, baseCopy, "image.apex/bin/basebin")
+	ensureNotContains(t, baseCopy, "image.apex/bin/overridebin")
 
 	ensureNotContains(t, copyCmds, "image.apex/app/app@TEST.BUILD_ID/app.apk")
 	ensureContains(t, copyCmds, "image.apex/app/override_app@TEST.BUILD_ID/override_app.apk")
-- 
2.53.0

