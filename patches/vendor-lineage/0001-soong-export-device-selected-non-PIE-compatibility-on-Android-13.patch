From e8a48fad9727062687dabc20b2549c5f70d32219 Mon Sep 17 00:00:00 2001
From: GuaiYiHu <guaiyihu@foxmail.com>
Date: Wed, 7 Oct 2026 21:05:39 +0800
Subject: [PATCH] soong: export device-selected non-PIE compatibility on
 Android 13

Register the allowlist directory only when the device explicitly provides it. Keep the configuration absent for products such as Aries, retaining the default PIE-only linker contract. Use the standard Soong config module for the linker defaults.

(cherry picked from commit 7ca1700c9116fd0c65bdb3d927b06d6e72112c48)

(cherry picked from commit fa13f020f8e604b1612d0197e5938fe72e462e2b)
Change-Id: I92a05310ed3e7a3f32a7b7d215c8b19239422c26
---
 build/soong/Android.bp     | 19 +++++++++++++++++++
 config/BoardConfigSoong.mk |  6 ++++++
 2 files changed, 25 insertions(+)

diff --git a/build/soong/Android.bp b/build/soong/Android.bp
index 1b984149..f93e88cd 100644
--- a/build/soong/Android.bp
+++ b/build/soong/Android.bp
@@ -469,3 +469,22 @@ stagefright_qcom_legacy {
         },
     },
 }
+
+// Optional exact-path compatibility for legacy vendor executables.
+soong_config_module_type {
+    name: "non_pie_executables",
+    module_type: "cc_defaults",
+    config_namespace: "lineageGlobalVars",
+    value_variables: ["non_pie_executables_header_dir"],
+    properties: ["cppflags", "include_dirs"],
+}
+
+non_pie_executables {
+    name: "non_pie_executables_defaults",
+    soong_config_variables: {
+        non_pie_executables_header_dir: {
+            cppflags: ["-DENABLE_NON_PIE_SUPPORT"],
+            include_dirs: ["%s"],
+        },
+    },
+}
diff --git a/config/BoardConfigSoong.mk b/config/BoardConfigSoong.mk
index 561f1628..afe43b57 100644
--- a/config/BoardConfigSoong.mk
+++ b/config/BoardConfigSoong.mk
@@ -125,3 +125,9 @@ else
 SOONG_CONFIG_lineageQcomVars_qcom_display_headers_namespace := $(QCOM_SOONG_NAMESPACE)/display
 endif
 SOONG_CONFIG_lineageQcomVars_qti_vibrator_effect_lib := $(TARGET_QTI_VIBRATOR_EFFECT_LIB)
+
+# Device-selected exact executable paths; absent devices retain PIE-only behavior.
+ifneq ($(strip $(LINKER_NON_PIE_EXECUTABLES_HEADER_DIR)),)
+SOONG_CONFIG_lineageGlobalVars += non_pie_executables_header_dir
+SOONG_CONFIG_lineageGlobalVars_non_pie_executables_header_dir := $(LINKER_NON_PIE_EXECUTABLES_HEADER_DIR)
+endif
