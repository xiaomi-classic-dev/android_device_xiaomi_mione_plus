on post-fs-data
    restorecon_recursive /sys/devices/i2c-0/0-0036/leds/backlight
    restorecon_recursive /sys/devices/platform/msm_ssbi.0/pm8058-core/pm8058-led/leds

service vendor.light-hal-aidl /vendor/bin/hw/android.hardware.light-service.mione
    interface aidl android.hardware.light.ILights/default
    class hal
    user system
    group system
